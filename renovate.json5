{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on Monday"],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies", "paseo-image"],
  "packageRules": [
    {
      "matchFileNames": ["images/paseo/package.json"],
      "groupName": "Paseo agent CLIs"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "Paseo image binary tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/paseo\\/versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\nPASEO_VERSION=(?<currentValue>\\S+)\\nPASEO_DIGEST=(?<currentDigest>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/paseo\\/versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
